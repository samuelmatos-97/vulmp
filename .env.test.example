# Copy this file to .env.test and set a unique test-only password.
# Never reuse the development database credentials.
# Select it explicitly with docker compose --env-file .env.test.

# Step 9.2 will require these database and user names in its safety checks.
TEST_POSTGRES_DB=vulmp_test_db
TEST_POSTGRES_USER=vulmp_test

# Leave no real credentials in this example. An empty password is rejected.
TEST_POSTGRES_PASSWORD=
