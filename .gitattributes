# Normalize text files when they are stored in Git.
* text=auto

# Keep source code and configuration files with Unix line endings.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.md text eol=lf
*.txt text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
